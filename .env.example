RP_MODE=sandbox
RP_TRANSPORT=stdio
RP_HOST=127.0.0.1
RP_PORT=3000
RP_DATA_DIR=./data
RP_WORKSPACE=local-demo
RP_TIMEOUT_MS=10000
# Browser dashboard (separate from the MCP-only server's RP_PORT).
RP_UI_PORT=3400
# Comma-separated exact HTTPS origins allowed for remote MCP connections.
# RP_UI_REMOTE_ORIGINS=https://your-server.example
# Set for HTTP clients. Required at >=32 characters when binding outside loopback.
# RP_AUTH_TOKEN=
# NitroCloud: set RP_TRANSPORT=http, RP_HOST=0.0.0.0 and a private RP_AUTH_TOKEN
# in platform environment settings. Managed builds can ignore the Dockerfile.
# Use a writable persistent RP_DATA_DIR; container disk is not proof of persistence.
# GitHub mode requires all four values below. Keep the marker secret stable.
# RP_GITHUB_OWNER=
# RP_GITHUB_REPO=
# RP_GITHUB_TOKEN=
# RP_MARKER_SECRET=
