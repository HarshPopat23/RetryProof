{
  "name": "retryproof",
  "version": "0.2.0",
  "description": "Evidence-first recovery for interrupted MCP workflows",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "dev": "npm run build && node dist/index.js",
    "test": "npm run build && node --test --test-concurrency=1 test/*.test.mjs",
    "test:coverage": "npm run build && node --experimental-test-coverage --test --test-concurrency=1 test/*.test.mjs",
    "demo": "npm run build && node scripts/demo.mjs",
    "verify": "node scripts/verify.mjs",
    "package": "node scripts/package.mjs",
    "dashboard": "npm run build && node dist/dashboard/index.js",
    "dashboard:start": "node dist/dashboard/index.js",
    "test:browser": "npm run build && node scripts/browser-check.mjs",
    "ui": "npm run build && node scripts/server.mjs",
    "experiments:local": "npm run build && node scripts/run-10-experiments.mjs --local-only",
    "experiments:live": "npm run build && node scripts/run-10-experiments.mjs --live"
  },
  "keywords": [],
  "author": "Harsh Popat",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@nitrostack/core": "1.1.2",
    "dotenv": "18.0.8",
    "reflect-metadata": "0.2.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "typescript": "7.0.2"
  },
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  }
}
